+def plaza_r4_evidence_clean(row, completed):
+    """Use the frozen native validator to recheck actual R4 prerequisite/bed receipts."""
+    path = CONTROL / 'plaza-bed-underlay-fix/r4/plaza-bed-native-r4.py'
+    try:
+        if sha(path.read_bytes()) != 'eeb01709edd4c22d35f2d4c1317fc343f61eddd4b6e55207aa3427abdef89a05':
+            return False
+        spec = importlib.util.spec_from_file_location('plaza_packet_bed_r4', path)
+        bed = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(bed)
+        bed.verify_focused()
+        label = row['label']
+        if label == 'city22-plaza-bed-tools-parse-r4':
+            raw, binding = bed.clean_records(label)
+            meta = json.loads((path.parent / 'plaza-bed-helpers-r4-meta.json').read_text())
+            return (plaza_fixed_source(row, completed)
