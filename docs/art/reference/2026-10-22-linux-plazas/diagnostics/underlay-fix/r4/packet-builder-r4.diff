+                    and 'ExternalSourceParseProbe: checked=4 failures=0' in (Path(binding['raw']).parent / 'logs/stdout.log').read_text())
+        discovery = path.parent / 'plaza-bed-discovery-r4.json'
+        meta, entries, hashes, _ = bed.validate(discovery)
+        if label == 'city22-plaza-bed-discovery-r4':
+            return plaza_fixed_source(row, completed)
+        match = re.fullmatch(r'city22-plaza-bed-native-r4-s([678])', label)
+        if match is None:
+            return False
+        segment = int(match.group(1))
+        outputs = [Path(arg[6:]) for arg in row['command'] if arg.startswith('--out=')]
+        if len(outputs) != 1:
+            return False
+        bed.native_acceptance(segment, entries[segment], outputs[0], label, hashes, meta)
+        return plaza_fixed_source(row, completed)
+    except (RuntimeError, ValueError, KeyError, OSError, TypeError):
+        return False
 
 
