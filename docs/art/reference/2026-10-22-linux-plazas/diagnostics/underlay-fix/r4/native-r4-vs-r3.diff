+def verify_focused(meta=None):
+    """Revalidate immutable completed R3 results; never rerun or rewrite runtime."""
+    meta = meta or load(FIX / 'plaza-bed-helpers-r4-meta.json')
+    for path, digest in meta['external_bindings'].items():
+        require(sha(path) == digest, 'Frozen prerequisite changed: ' + path)
+    for helper in meta['helpers'].values():
+        require(sha(helper['gd']) == helper['sha256'] and sha(helper['scene']) == helper['scene_sha256'], 'Frozen bed helper changed')
+    for relative, digest in meta['parent_runtime_sha256'].items():
+        require(sha(PROJECT / relative) == digest, 'Current fixed source changed: ' + relative)
+    assertions = load(FIX.parent / 'r3/assertion-manifest.json')
