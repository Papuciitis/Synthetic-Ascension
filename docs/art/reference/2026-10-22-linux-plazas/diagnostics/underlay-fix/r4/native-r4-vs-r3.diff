+            require(raw['source_hashes'].get(relative) == digest, 'Prior regression source differs: ' + relative)
+        require(report.get('passes') == (31 if red else 39) and report.get('failures') == (8 if red else 0) and report.get('save_writes') == 0 and report.get('semantic_terrain') == 'urban' and report.get('generator_underlay_matches_native') is True, 'Prior regression causal/count/save report differs')
+        states = report.get('states', [])
+        require(len(states) == 5 and {row.get('state') for row in states} == set(range(5)), 'Prior regression five-state matrix differs')
+        require(all(row.get('outside_ok') is True and row.get('material_ok') == (not red or row['state'] == 0) and row.get('care_ok') == (not red or row['state'] == 0) for row in states), 'Prior regression state checks differ')
+        require(assertions['red_footer' if red else 'green_footer'] in Path(case['stdout']).read_text(), 'Prior regression footer absent')
+        result.append(dict(case))
+    interrupted = meta['r3_interruption']
+    old = load(interrupted['executor_summary']); guard = load(interrupted['guard'])
+    require(old.get('green_clean') is True and old.get('completed_discovery') is False and old.get('interrupted_signal') == 15 and old.get('final_runtime_sha256') == meta['parent_runtime_sha256']['core/systems/world/proc/chunkgen/PlazaPresentation.gd'], 'R3 interruption summary differs')
+    require(guard.get('reason') == 'external_sigterm' and guard.get('received_signal') == 15 and guard.get('owned_pids') == [] and guard.get('throttle_cycles') == 0 and all(row.get('owned_engine_live') is False for row in guard.get('samples', [])), 'R3 interruption was not the recorded no-owned-engine queued stop')
+    require(not list(RUNS.glob('city22-plaza-bed-tools-parse-r3-*')), 'R3 parser now has unexpected raw evidence; review before resume')
