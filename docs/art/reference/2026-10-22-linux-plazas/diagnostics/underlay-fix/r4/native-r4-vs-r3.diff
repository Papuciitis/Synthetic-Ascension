+    for case in meta['prior_focused_cases']:
+        for key in ['raw', 'guard', 'report', 'stdout']:
+            require(sha(case[key]) == case[key + '_sha256'], 'Prior regression record changed: ' + case[key])
+        raw, guard, report = load(case['raw']), load(case['guard']), load(case['report'])
+        red = case['red']; code = 1 if red else 0
+        require(raw.get('ended_utc') and raw.get('actual_exit') == code and raw.get('runner_exit') == code and raw.get('stop_reason') == ('nonzero_exit' if red else 'completed'), 'Prior regression exit differs')
+        require(guard.get('reason') == 'completed' and guard.get('wrapper_exit') == code and guard.get('received_signal') is None, 'Prior regression guard not normally completed')
+        require(raw.get('diagnostics') == (assertions['red_diagnostics'] if red else []), 'Prior regression diagnostics differ')
+        expected = dict(meta['parent_runtime_sha256'], **case['source_overrides'])
+        require(Path(raw['project_root']).resolve() == PROJECT and 'res://tools/tests/PlazaBedUnderlayTest.tscn' in raw['command'] and '--out=' + case['report'] in raw['command'], 'Prior regression command differs')
