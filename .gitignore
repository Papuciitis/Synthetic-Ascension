# Godot 4+ specific ignores
.godot/
/android/
/.worktrees/

# Export output. Regenerated by any export; 180 MB per build.
/build/
# Baked by tools/package_release.ps1 for exported builds (BuildInfo)
build_info.json

# Flight-recorder captures under the dated folders are per-machine: generated
# by every editor run on whichever machine is being profiled, read only by
# tools/perf/analyze_captures.py on that same machine. Both the JSON incidents
# (cleanup audit E1) and the CSVs stay local. performance_results/benchmarks/
# (the pressure-gate baseline and the benchmark reports) stays tracked.
/performance_results/20*/*.json
/performance_results/20*/*.csv

# Stale export archive; exports are regenerated, never versioned.
/build.zip
