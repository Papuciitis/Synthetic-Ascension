# Godot 4+ specific ignores
.godot/
/android/
/.worktrees/

# Export output. Regenerated by any export; 180 MB per build.
/build/
# Baked by tools/package_release.ps1 for exported builds (BuildInfo)
build_info.json

# Flight-recorder JSON captures: generated by every editor run, ~1.5 MB each,
# read by nothing (tools/perf/analyze_captures.py consumes the CSVs). Keep the
# CSVs for cross-machine comparison; JSON stays local. (cleanup audit E1)
/performance_results/20*/*.json
