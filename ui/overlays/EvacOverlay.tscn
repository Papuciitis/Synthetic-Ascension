[gd_scene format=3 uid="uid://evacoverlay"]

[sub_resource type="Shader" id="ShaderVignette"]
code = "shader_type canvas_item;
// The evacuation's closing-in: the screen's edges darken toward a deep ember
// as the pressure rises (HudEvacOverlayController sets the strength when the
// director's numbers move, never per frame on its own).
uniform float vignette_strength = 0.18;
uniform float noise_strength = 0.015;
uniform float noise_scale = 260.0;
uniform vec4 tint : source_color = vec4(0.1, 0.028, 0.008, 1.0);

float hash(vec2 p){
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void fragment(){
	vec2 uv = SCREEN_UV;
	vec2 p = uv * 2.0 - 1.0;

	float d = length(p * vec2(1.0, 0.9));
	float edge = smoothstep(0.45, 1.2, d);

	float n = hash(uv * noise_scale);
	float a = edge * vignette_strength * 1.15 + (n - 0.5) * noise_strength;
	a = clamp(a, 0.0, 0.5);
	// Warmer toward the rim, near-black just inside it.
	vec3 col = mix(vec3(0.0), tint.rgb, smoothstep(0.7, 1.25, d));
	COLOR = vec4(col, a);
}
"

[sub_resource type="ShaderMaterial" id="MatVignette"]
shader = SubResource("ShaderVignette")
shader_parameter/vignette_strength = 0.18
shader_parameter/noise_strength = 0.015
shader_parameter/noise_scale = 260.0
shader_parameter/tint = Color(0.1, 0.028, 0.008, 1)

