[sub_resource type="Shader" id="ShaderVignette"]
code = "shader_type canvas_item;
// The top/bottom shade, the vignette and film grain in one black pass.

uniform sampler2D shade : filter_linear;
uniform float vignette_strength = 0.5;
uniform float grain = 0.022;

float hash(vec2 p){
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void fragment(){
	vec2 p = SCREEN_UV * 2.0 - 1.0;
	p.x *= 0.8;
	float edge = smoothstep(0.5, 1.3, length(p));
	float n = hash(floor(FRAGCOORD.xy) + fract(TIME * 7.0) * 91.0);
	float v = clamp(edge * vignette_strength + (n - 0.5) * grain, 0.0, 0.75);
	float s = texture(shade, vec2(0.5, UV.y)).a;
	COLOR = vec4(0.0, 0.0, 0.0, 1.0 - (1.0 - s) * (1.0 - v));
}
"

[sub_resource type="ShaderMaterial" id="MatVignette"]
shader = SubResource("ShaderVignette")
shader_parameter/shade = SubResource("ShadeTexture")

