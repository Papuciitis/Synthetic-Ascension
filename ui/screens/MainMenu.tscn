[sub_resource type="Shader" id="ShaderVignette"]
code = "shader_type canvas_item;

uniform float vignette_strength = 0.35;
uniform float noise_strength = 0.015;
uniform float noise_scale = 260.0;

float hash(vec2 p){
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void fragment(){
	vec2 uv = SCREEN_UV;
	vec2 p = uv * 2.0 - 1.0;

	float d = length(p);
	float edge = smoothstep(0.40, 1.12, d);

	float n = hash(uv * noise_scale);
	float a = edge * vignette_strength + (n - 0.5) * noise_strength;
	a = clamp(a, 0.0, 0.50);

	COLOR = vec4(0.0, 0.0, 0.0, a);
}
"

[sub_resource type="ShaderMaterial" id="MatVignette"]
shader = SubResource("ShaderVignette")
shader_parameter/vignette_strength = 0.35
shader_parameter/noise_strength = 0.015
shader_parameter/noise_scale = 260.0

