[sub_resource type="Shader" id="ShaderVignette"]
code = "shader_type canvas_item;
// One pass for every black layer over the painting: the left shade the menu
// reads on, the bottom shade under the menu, the vignette and film grain.
// Black layers compose as alpha = 1 - (1-a)(1-b)(1-c), so this is exact.

uniform sampler2D shade_left : filter_linear;
uniform sampler2D shade_bottom : filter_linear;
uniform float vignette_strength = 0.42;
uniform float grain = 0.022;

float hash(vec2 p){
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void fragment(){
	vec2 p = SCREEN_UV * 2.0 - 1.0;
	p.x *= 0.82;
	float edge = smoothstep(0.55, 1.35, length(p));
	float n = hash(floor(FRAGCOORD.xy) + fract(TIME * 7.0) * 91.0);
	float v = clamp(edge * vignette_strength + (n - 0.5) * grain, 0.0, 0.7);
	float l = texture(shade_left, vec2(UV.x, 0.5)).a;
	float b = texture(shade_bottom, vec2(0.5, UV.y)).a;
	COLOR = vec4(0.0, 0.0, 0.0, 1.0 - (1.0 - l) * (1.0 - b) * (1.0 - v));
}
"

[sub_resource type="ShaderMaterial" id="MatVignette"]
