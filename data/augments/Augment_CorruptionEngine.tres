[resource]
script = ExtResource("1_crpsc")
id = &"augment_corruption_engine"
display_name = "Corruption Engine"
description = "Your two strongest curses become a measured source of Power."
card_blurb = "Your 2 strongest curses grant Power. Negative merges deepen curses."
details = "Passive: your 2 strongest active statistical-slot curses grant Power.
At Lv.1, 25% of their combined severity becomes Power.
The share approaches 50% with rank; Power is capped at +45%.
Stat slots: HP, Armor, Move Speed, Power, Haste and Luck; excludes Offhand and Ring.
A curse suppressed by Inversion Lens contributes nothing.
While equipped, negative merges keep the more severe roll instead of easing it."
icon = ExtResource("2_crpic")
metadata/_custom_type_script = "uid://d0m4jhgfdwlyp"
