[ext_resource type="Texture2D" path="res://assets/ui/augments/cards/doctrine_of_burden.png" id="2_docbr"]

[resource]
script = ExtResource("1_docbr")
id = &"augment_doctrine_of_burden"
display_name = "Doctrine of Burden"
description = "Each curse borne by the body becomes another layer of protection."
card_blurb = "Each qualifying curse grants Armor and Max HP. Counts, not severity."
details = "Lv.1 baseline:
Each qualifying statistical-slot curse grants +8 Armor and +4.5% Max HP.
The curse must use at least 10% of that item's own curse range (its authored negative roll range).
Stat slots: HP, Armor, Move Speed, Power, Haste and Luck; excludes Offhand and Ring.
A curse suppressed by Inversion Lens does not count.
Counts curses rather than their severity.
Bonuses improve with rank; ordinary negative merges can ease curses while keeping them above the threshold."
icon = ExtResource("2_docbr")
metadata/_custom_type_script = "uid://d0m4jhgfdwlyp"
