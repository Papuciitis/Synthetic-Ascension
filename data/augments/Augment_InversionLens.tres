[ext_resource type="Script" uid="uid://d0m4jhgfdwlyp" path="res://core/systems/augments/AugmentData.gd" id="1_invls"]
[ext_resource type="Texture2D" path="res://assets/ui/augments/cards/inversion_lens.png" id="2_invls"]

[resource]
script = ExtResource("1_invls")
id = &"augment_inversion_lens"
display_name = "Inversion Lens"
description = "One severe curse is inverted into a measured source of strength."
card_blurb = "Suppresses your strongest curse and returns part of it as a bonus."
details = "Passive: suppress your strongest curse in a statistical slot.
Its penalty stops applying; 55% of its severity returns as that slot's stat.
Luck gains 15% of the suppressed severity at Lv.1; the share approaches 30% with rank.
Stat slots: HP, Armor, Move Speed, Power, Haste and Luck; excludes Offhand and Ring.
The item remains negative for balance, sets and acquisition.
The suppressed curse does not feed Corruption Engine or Litany of Wounds, or count for Doctrine of Burden."
icon = ExtResource("2_invls")
metadata/_custom_type_script = "uid://d0m4jhgfdwlyp"
