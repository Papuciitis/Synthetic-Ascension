[resource]
script = ExtResource("1_nxmfh")
id = &"augment_spirit_slash"
display_name = "Spirit Slash"
description = "A spectral edge cuts nearby enemies and leaves lasting wounds."
card_blurb = "Active: slash nearby enemies. Bleeds; may stun or refund cooldown."
details = "Lv.1 baseline:
Active: strike the 2 nearest enemies within 180px.
Cooldown: 2.5s.
Each hit: 2.4× your attack damage.
Applies 2 Bleed stacks for 3s; each ticks every 0.5s for 6% of the hit.
+1 Bleed stack per 4 ranks above Lv.1, up to 4 stacks.
Ordinary casts always strike at most 2 targets.
12% chance to stun for 0.35s and knock back; this adds no critical damage.
50% chance to refund a manual cast's cooldown.
Damage gains +35% of its Lv.1 value per rank."
icon = ExtResource("2_kfpgv")
