[resource]
script = ExtResource("1_cn18f")
id = &"augment_reflect_shield"
display_name = "Reflect Shield"
description = "A timed ward returns incoming shots and releases a short arc on a perfect parry."
mods_scale_per_level = 0.2
card_blurb = "Parry to return shots. Perfect parries send lightning through nearby foes."
details = "Lv.1 baseline:
Passive: +8 Armor; improves with rank.
Active parry: 0.14s window; perfect during the first 0.06s.
Cooldown: 0.40s; a perfect parry cuts it short: ready again 0.1s after the ward closes.
Returned shot: 95% damage, 105% speed.
Perfect parry: zap 3 targets within 220px and stun for 0.12s.
Zap damage: the greater of 35% of the returned shot or 1.2× your attack damage.
Zap gains +35% of its Lv.1 value per rank."
