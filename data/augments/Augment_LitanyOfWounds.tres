[resource]
script = ExtResource("1_aug")
id = &"augment_litany_of_wounds"
display_name = "Litany of Wounds"
description = "The weight of active curses becomes momentum as health falls."
card_blurb = "Below 80% HP, active curses grant Haste. Full strength at 30% HP."
details = "Passive: active statistical-slot curse severity grants Haste as health falls.
Starts below 80% HP; reaches full strength at 30% HP.
At full strength and Lv.1, gain 35% of total active severity as Haste.
The share approaches 70% with rank; Haste is capped at +45%.
A curse suppressed by Inversion Lens contributes nothing.
Requiem starts below 85% HP, is full at 35%, grants Power too, and caps each bonus at +70%."
icon = ExtResource("2_icon")
effect_scenes = Array[PackedScene]([ExtResource("3_fx")])
metadata/_custom_type_script = "uid://d0m4jhgfdwlyp"
