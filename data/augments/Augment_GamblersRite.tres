[resource]
script = ExtResource("1_aug")
id = &"augment_gamblers_rite"
display_name = "Gambler's Rite"
description = "The crowd loves watching him court disaster."
card_blurb = "Every new curse you pick up may pay a Follower; the first of each distinct curse per segment banks Resonance."
details = "Passive: every legitimately new NEG item you
pick up from the world (equipped, bagged or
fed) has a 15% chance (+ up to 20% from Luck)
of +1 Follower. The first pickup of each
distinct NEG base item per segment adds +0.5%
Resonance, capped at +4% per segment.
Trades, rewards, moves and undo are not
pickups. You never have to wear the curse."
icon = ExtResource("2_icon")
