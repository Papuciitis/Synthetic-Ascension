[resource]
script = ExtResource("1_aug")
id = &"augment_gamblers_rite"
display_name = "Gambler's Rite"
description = "Newly found curses bring Followers and strengthen your Resonance."
card_blurb = "New curse pickups may grant Followers and bank Resonance."
details = "Each new negative item found in the world has a 35% chance to grant 1 Follower at Lv.1.
+1.5 percentage points per rank above Lv.1; Luck adds up to 20 points.
Total chance is capped at 60%.
The first of each distinct negative item per segment grants +2% Resonance, up to +12%.
Works whether you equip, bag or feed the pickup.
Trades, rewards, inventory moves and undo do not count.
House Edge raises the chance cap to 70% and grants 2 Followers."
icon = ExtResource("2_icon")
metadata/_custom_type_script = "uid://d0m4jhgfdwlyp"
