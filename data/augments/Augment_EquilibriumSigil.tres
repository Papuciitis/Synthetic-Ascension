[resource]
script = ExtResource("1_aug")
id = &"augment_equilibrium_sigil"
display_name = "Equilibrium Sigil"
description = "A balanced lattice rewards equal positive and negative equipment."
card_blurb = "Equal positive and negative counts grant Power and Haste."
details = "Passive: equip equal positive and negative item counts, with at least 2 of each.
Counts all 8 slots by polarity; severity does not matter.
At Lv.1: +12% Power and +12% Haste.
Bonuses improve with rank, capped at +20% each.
One extra item of either polarity breaks the balance.
A curse suppressed by Inversion Lens still counts as negative.
While slotted, new pickups go to your bag instead of auto-equipping."
icon = ExtResource("2_icon")
metadata/_custom_type_script = "uid://d0m4jhgfdwlyp"
