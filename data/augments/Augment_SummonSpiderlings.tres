[resource]
script = ExtResource("1_g8y7y")
id = &"augment_summon_spiderlings"
display_name = "Summon Spiderlings"
description = "Summoned spiderlings hunt nearby enemies and release a controlled blast on command."
mods_scale_per_level = 0.25
card_blurb = "Summon spiders. Detonate the brood on command."
details = "Lv.1 baseline:
Active: summon 2 spiderlings at your cursor, up to 320px away.
Cooldown: 1.25s. Lifetime: 12s.
+1 spiderling per 2 ranks above Lv.1, up to 6 per cast.
Living cap: 6 + rank, up to 14 (7 at Lv.1; 11 at Lv.5).
Bite: 0.5× your attack damage.
Detonate: 1.4× your attack damage in a 70px radius.
Use the detonate action to explode your living spiderlings.
Damage gains +35% of its Lv.1 value per rank.
Reach, cooldown, lifetime and blast radius improve with rank.
Passive: +5% Power; improves with rank."
icon = ExtResource("2_h2oa5")
mods = SubResource("Resource_6kvc0")
effect_scenes = Array[PackedScene]([ExtResource("1_0xx37")])
