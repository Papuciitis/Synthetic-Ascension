glossary = {"Active ability": "A set action triggered with the displayed combat key.", "Haste": "Shortens attack and ability recovery times.", "Primed": "The next eligible attack consumes one stored discharge.", "Set strength": "Scaling derived from the rarity and upgrade state of equipped set pieces."}
