[ext_resource type="Script" path="res://core/systems/major_choice/effects/MCE_ModAttemptFloat.gd" id="2"]

[sub_resource type="Resource" id="eff_radius"]
script = ExtResource("2")
property = &"attempt_wardstone_radius_mul"
