[resource]
script = ExtResource("1")
id = &"major_sanctum"
title = "Wardstone Sanctum"
description = "Wardstones project a larger sanctuary.\n• +25% sanctuary radius\n• Stronger slow inside the field"
category = &"utility"
effects = Array[Resource]([SubResource("eff_radius"), SubResource("eff_slow")])
