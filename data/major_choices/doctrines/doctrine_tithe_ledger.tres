[resource]
script = ExtResource("1")
id = &"doctrine_tithe_ledger"
title = "Tithe Ledger"
description = "Collect the congregation's tithe before the sermon is written."
stage = &"doctrine"
offer_role = &"covenant"
family_id = &"archive"
