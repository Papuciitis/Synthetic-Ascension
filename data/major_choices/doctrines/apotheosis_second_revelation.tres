[resource]
script = ExtResource("1")
id = &"doctrine_apotheosis_second_revelation"
title = "Second Revelation"
description = "Make the miracle a schedule rather than an event."
stage = &"apotheosis"
offer_role = &"transfigure"
family_id = &"vessel"
gift_text = "Revelation charge is gained three times as fast, from every source."
price_text = "Maximum health is reduced by 25%."
consequence_text = "Divinity is no longer an event; it is a schedule."
effects = Array[Resource]([SubResource("effect_1"), SubResource("effect_2")])
