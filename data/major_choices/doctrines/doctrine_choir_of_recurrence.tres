[ext_resource type="Script" path="res://core/systems/major_choice/effects/MCE_UpgradeEquippedAugments.gd" id="2"]
[ext_resource type="Script" path="res://core/systems/major_choice/effects/MCE_AddStatDelta.gd" id="3"]
[ext_resource type="Script" path="res://data/StatDelta.gd" id="4"]

[sub_resource type="Resource" id="effect_levels"]
