[resource]
script = ExtResource("1")
id = &"doctrine_choir_of_recurrence"
title = "Choir of Recurrence"
description = "Make every installed intelligence repeat the same impossible theorem."
stage = &"doctrine"
offer_role = &"amplify"
family_id = &"circuit"
gift_text = "+2 levels to every equipped augment and +15% Haste."
price_text = "Weapon Power is reduced by 15%."
consequence_text = "The choir perfects its own operations while the mortal weapon becomes secondary."
build_tags = Array[StringName]([&"active_augment"])
effects = Array[Resource]([SubResource("effect_levels"), SubResource("effect_stats")])
