[gd_resource type="Resource" script_class="MajorChoiceDef" format=3]

[ext_resource type="Script" path="res://core/systems/major_choice/MajorChoiceDef.gd" id="1"]
[ext_resource type="Script" path="res://core/systems/major_choice/effects/MCE_AddStatDelta.gd" id="2"]
[ext_resource type="Script" path="res://data/StatDelta.gd" id="3"]
[ext_resource type="Script" path="res://core/systems/major_choice/effects/MCE_AddDoctrineTag.gd" id="4"]

[sub_resource type="Resource" id="stats"]
script = ExtResource("3")
haste = 0.2

[sub_resource type="Resource" id="effect_stats"]
script = ExtResource("2")
delta = SubResource("stats")

[sub_resource type="Resource" id="effect_cooldown"]
script = ExtResource("4")
rule_key = &"active_augment_cooldown_mul"
value = 0.7

[sub_resource type="Resource" id="effect_lock"]
script = ExtResource("4")
rule_key = &"active_augment_cross_lock_seconds"
value = 2.0

[resource]
script = ExtResource("1")
id = &"doctrine_method_open_circuit"
title = "Open Circuit"
description = "Unseal the active lattice and accept its interference."
stage = &"method"
offer_role = &"amplify"
family_id = &"circuit"
gift_text = "+20% Haste. Active augment cooldowns are reduced by 30%."
price_text = "Activating an augment locks the other active augments for 2 seconds."
consequence_text = "Your body is now an open circuit: faster, louder, and unable to isolate its instruments."
build_tags = Array[StringName]([&"active_augment"])
effects = Array[Resource]([SubResource("effect_stats"), SubResource("effect_cooldown"), SubResource("effect_lock")])
